  "engines": {
    "node": "^22.19 || ^24.11 || >=26",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "pnpm clean:cache && nuxt prepare",
    "clean:cache": "rimraf .data node_modules/.cache",
    "dev": "nuxt dev",
    "dev:host": "nuxt dev --host",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "lint": "eslint && stylelint '**/*.{vue,scss}'",
    "lint:fix": "eslint --fix && stylelint '**/*.{vue,scss}' --fix",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json && tsc --noEmit -p .nuxt/tsconfig.server.json",
    "probe:api": "node scripts/probe/api-client.mjs",
    "probe:live": "node --env-file-if-exists=.env scripts/probe/live.mjs",
    "probe:lexical": "node scripts/probe/lexical-projection.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
